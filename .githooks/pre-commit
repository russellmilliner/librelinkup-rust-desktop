#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
[[ -z "$STAGED" ]] && exit 0

if echo "$STAGED" | grep -qE '(^(Cargo\.(toml|lock)|crates/.*/Cargo\.toml|rustfmt\.toml)$|^(src|crates|tests)/.*\.rs$|^build\.rs$)'; then
    echo "[pre-commit] Checking root/core Rust formatting and clippy..."
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
fi

if echo "$STAGED" | grep -qE '(^windows/.*(\.rs$|Cargo\.(toml|lock)$)|^rustfmt\.toml$)'; then
    echo "[pre-commit] Checking windows/ Rust formatting..."
    cargo fmt --manifest-path windows/Cargo.toml -- --check
    if [[ "$(uname -s)" == *MINGW* || "$(uname -s)" == *MSYS* ]] || pkg-config --exists alsa 2>/dev/null; then
        echo "[pre-commit] Checking windows/ clippy..."
        cargo clippy --manifest-path windows/Cargo.toml --all-targets -- -D warnings
    fi
fi

STAGED_QML="$(echo "$STAGED" | grep -E '^src/qml/[^/]+\.qml$' || true)"
if echo "$STAGED" | grep -qx '\.qmllint\.ini'; then
    STAGED_QML="$(printf '%s\n' src/qml/*.qml)"
fi
if [[ -n "$STAGED_QML" ]]; then
    QMLLINT_BIN=""
    for cand in /usr/lib/qt6/bin/qmllint "$(command -v qmllint6 2>/dev/null || true)" "$(command -v qmllint 2>/dev/null || true)"; do
        [[ -z "$cand" || ! -x "$cand" ]] && continue
        if "$cand" --version 2>/dev/null | grep -qE '^qmllint 6\.'; then
            QMLLINT_BIN="$cand"
            break
        fi
    done
    if [[ -n "$QMLLINT_BIN" ]]; then
        QML_IMPORT_DIR=""
        for qm in "$(command -v qmake6 2>/dev/null || true)" /usr/lib/qt6/bin/qmake "$(command -v qmake 2>/dev/null || true)"; do
            [[ -z "$qm" || ! -x "$qm" ]] && continue
            QML_IMPORT_DIR="$("$qm" -query QT_INSTALL_QML 2>/dev/null || true)"
            if [[ -n "$QML_IMPORT_DIR" && -d "$QML_IMPORT_DIR" ]]; then
                break
            fi
            QML_IMPORT_DIR=""
        done
        if [[ -z "$QML_IMPORT_DIR" ]]; then
            for d in /usr/lib/qt6/qml /usr/lib/x86_64-linux-gnu/qt6/qml; do
                if [[ -d "$d" ]]; then
                    QML_IMPORT_DIR="$d"
                    break
                fi
            done
        fi
        echo "[pre-commit] Running Qt 6 qmllint on staged QML files..."
        # shellcheck disable=SC2086
        if [[ -n "$QML_IMPORT_DIR" ]]; then
            "$QMLLINT_BIN" -I "$QML_IMPORT_DIR" -I src/qml $STAGED_QML
        else
            "$QMLLINT_BIN" -I src/qml $STAGED_QML
        fi
    fi
fi

STAGED_CPP="$(echo "$STAGED" | grep -E '^src/cpp/[^/]+\.(h|cpp)$' || true)"
if [[ -n "$STAGED_CPP" ]] && command -v g++ >/dev/null 2>&1 && pkg-config --exists Qt6Core Qt6Gui Qt6Widgets Qt6Quick Qt6Qml Qt6Svg Qt6Network Qt6DBus 2>/dev/null; then
    QT_CFLAGS="$(pkg-config --cflags Qt6Core Qt6Gui Qt6Widgets Qt6Quick Qt6Qml Qt6Svg Qt6Network Qt6DBus)"
    KF6_CFLAGS="$(pkg-config --cflags KF6ColorScheme KF6ConfigCore KF6IconThemes KF6StatusNotifierItem 2>/dev/null || true)"
    for base in "${KF6_INCLUDE_DIR:-}" /usr/include/KF6 /usr/local/include/KF6 /usr/include/x86_64-linux-gnu/KF6; do
        [[ -z "$base" || ! -d "$base" ]] && continue
        for mod in KColorScheme KConfig KConfigCore KIconThemes KStatusNotifierItem; do
            if [[ -d "$base/$mod" && "$KF6_CFLAGS" != *"-I$base/$mod"* ]]; then
                KF6_CFLAGS="$KF6_CFLAGS -I$base/$mod"
            fi
        done
    done
    if [[ -n "$KF6_CFLAGS" ]]; then
        echo "[pre-commit] Checking staged C++17 / Qt6 / KF6 sources..."
        # shellcheck disable=SC2086
        echo '#include "app_helper.h"' | g++ -std=c++17 -fsyntax-only -Wall -Wextra -Werror -Isrc/cpp $QT_CFLAGS $KF6_CFLAGS -x c++ -
        while IFS= read -r cpp; do
            [[ "$cpp" == *.cpp ]] || continue
            # shellcheck disable=SC2086
            g++ -std=c++17 -fsyntax-only -Wall -Wextra -Werror -Isrc/cpp $QT_CFLAGS $KF6_CFLAGS "$cpp"
        done <<< "$STAGED_CPP"
    fi
fi

STAGED_SH="$(echo "$STAGED" | grep -E '(\.sh$|^\.githooks/pre-commit$)' || true)"
if [[ -n "$STAGED_SH" ]]; then
    echo "[pre-commit] Checking staged shell scripts..."
    while IFS= read -r shf; do
        [[ -z "$shf" ]] && continue
        bash -n "$shf"
        if command -v shellcheck >/dev/null 2>&1; then
            shellcheck -S warning "$shf"
        fi
    done <<< "$STAGED_SH"
fi

if echo "$STAGED" | grep -qx 'src/cpp/resources/kwin-resident.js' && command -v node >/dev/null 2>&1; then
    echo "[pre-commit] Checking KWin JS helper..."
    node --check src/cpp/resources/kwin-resident.js
fi

if echo "$STAGED" | grep -qx 'data/io.github.russellmilliner.LibreLinkUpDesktop.desktop' && command -v desktop-file-validate >/dev/null 2>&1; then
    echo "[pre-commit] Validating .desktop entry..."
    desktop-file-validate data/io.github.russellmilliner.LibreLinkUpDesktop.desktop
fi

if echo "$STAGED" | grep -qx 'data/io.github.russellmilliner.LibreLinkUpDesktop.metainfo.xml'; then
    if command -v appstreamcli >/dev/null 2>&1; then
        echo "[pre-commit] Validating AppStream metainfo..."
        appstreamcli validate --no-net data/io.github.russellmilliner.LibreLinkUpDesktop.metainfo.xml
    fi
    if command -v xmllint >/dev/null 2>&1; then
        xmllint --noout data/io.github.russellmilliner.LibreLinkUpDesktop.metainfo.xml
    fi
fi
